<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nubouncer</ToolCommandName>
    <PackageId>NuBouncer</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marcus Smallman-Lewis</Authors>
    <Description>Stops AI coding agents adding NuGet packages that don't exist or look dodgy. Checks packages before they're installed: does it exist, is it brand new, barely downloaded, spoofing a trusted prefix, deprecated or vulnerable?</Description>
    <PackageTags>nuget;security;supply-chain;slopsquatting;ai;claude-code;agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/marcus-smallman-lewis/nubouncer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <InternalsVisibleTo Include="NuBouncer.Tests" />
  </ItemGroup>

</Project>
